---
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import portfolio from '../../data/portfolio.json';
const projects = portfolio.filter(item => item.category === 'projects');
---
<Layout title="Projects" active="Projects">
  <section class="page-intro"><h1>Projects<span class="page-count" aria-label={`${projects.length} projects`}>({String(projects.length).padStart(2, '0')})</span></h1><p>Research and experiments across AI agents, multimodal systems, generative design, and spatial intelligence.</p></section>
  <section class="gallery-page" aria-label="Research projects"><ProjectGrid projects={projects} /></section>
</Layout>
