---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedWriting, formatDate } from '../../lib/writing';
import { url } from '../../lib/site';
export async function getStaticPaths() {
  return (await publishedWriting()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Layout title={post.data.title} description={post.data.description} active="Writing">
  <article class="article">
    <a class="text-link" href={url('writing/')}>Writing</a>
    <header style="margin-top:30px"><h1>{post.data.title}</h1><p class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ')}`}</p></header>
    {headings.filter(heading => heading.depth === 2).length > 1 && <nav class="article-toc" aria-label="On this page"><p>On this page</p><ul>{headings.filter(heading => heading.depth === 2).map(heading => <li><a class="text-link" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
    <div class="prose"><Content /></div>
  </article>
</Layout>
