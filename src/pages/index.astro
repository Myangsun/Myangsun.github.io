---
import Layout from '../layouts/Layout.astro';
import SelectedProjects from '../components/SelectedProjects.astro';
import ResearchInterests from '../components/ResearchInterests.astro';
import portfolio from '../data/portfolio.json';
import { site, url } from '../lib/site';
import { publishedWriting } from '../lib/writing';
import ArticleList from '../components/ArticleList.astro';
const selected = portfolio.filter(item => item.category === 'projects').slice(0, 6);
const projectCount = portfolio.filter(item => item.category === 'projects').length;
const latest = (await publishedWriting()).slice(0, 3);
---
<Layout>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-intro-heading">
      <div>
        <h1 id="home-title" class="home-name">{site.name}</h1>
        <p class="role">{site.role}</p>
      </div>
    </div>
    <div class="home-about">
      {site.introduction.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </section>
  <section class="selected-work" aria-labelledby="selected-title">
    <div class="section-heading"><h2 id="selected-title" tabindex="-1">Selected projects <span class="item-count">({String(selected.length).padStart(2, '0')})</span></h2><a class="text-link" href={url('projects/')}>All projects <span class="item-count">({String(projectCount).padStart(2, '0')})</span></a></div>
    <SelectedProjects projects={selected} />
  </section>
  <ResearchInterests />
  {latest.length > 0 && <section class="home-writing" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Latest writing</h2><a class="text-link" href={url('writing/')}>All writing</a></div>
    <ArticleList posts={latest} />
  </section>}
  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
    <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
  </section>
</Layout>
