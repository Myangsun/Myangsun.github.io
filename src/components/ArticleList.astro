---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/writing';
import { url } from '../lib/site';
interface Props { posts: CollectionEntry<'writing'>[]; }
const { posts } = Astro.props;
---
<div class="article-list collection-grid">
  {posts.map(post => <a class="article-card" href={url(`writing/${post.id}/`)}>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
    <span class="article-card-arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
